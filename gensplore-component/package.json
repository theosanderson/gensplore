{
  "name": "gensplore",
  "version": "0.0.0",
  "description": "React component for displaying genbank files",
  "keywords": [
    "genbank",
    "genomics",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/theosanderson/gensplore",
    "directory": "gensplore-component"
  },
  "devDependencies": {
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/open-sans-condensed": "^4.5.5",
    "@headlessui/react": "^2.2.10",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-links": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.11",
    "@teselagen/bio-parsers": "^0.4.38",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "color-hash": "^2.0.2",
    "events": "^3.3.0",
    "postcss": "^8.5.28",
    "postcss-prefix-selector": "^2.2.1",
    "rc-slider": "^11.1.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-toastify": "^11.1.0",
    "react-use": "^17.6.1",
    "rolldown": "^1.2.7",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-css-injected-by-js": "^5.0.2"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "main": "./dist/gensplore.cjs",
  "module": "./dist/gensplore.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "vite",
    "build": "vite build && node scripts/copy-types.mjs",
    "serve": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "node --test src/comparison/*.test.mjs",
    "prepack": "yarn build",
    "test:package": "yarn build && node scripts/check-package.mjs",
    "test:previews": "node scripts/check-previews.mjs"
  },
  "packageManager": "yarn@4.18.0",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/gensplore.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/gensplore.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": true,
  "resolutions": {
    "@babel/runtime": "^7.29.7"
  }
}
